{
  "name": "@hostlogic/mcp",
  "version": "1.0.0",
  "description": "MCP server for HostLogic AI Receptionist — connect Claude, Cursor or any MCP client to the HostLogic Enterprise API",
  "keywords": [
    "mcp",
    "hostlogic",
    "ai-receptionist",
    "pms",
    "hospitality"
  ],
  "homepage": "https://hostlogic.io/enterprise/mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mitalproperties/hostlogic-mcp.git"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "hostlogic-mcp": "dist/stdio.js"
  },
  "main": "./dist/server.js",
  "exports": {
    ".": "./dist/server.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev:stdio": "tsx src/stdio.ts",
    "dev:http": "tsx src/http.ts",
    "start": "node dist/http.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.2",
    "express": "^4.19.2",
    "node-fetch": "^3.3.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "tsx": "^4.15.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18"
  }
}
